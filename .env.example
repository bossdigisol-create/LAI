# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.

# Public URL of the site (used for canonical URLs, sitemap and Open Graph tags).
NEXT_PUBLIC_SITE_URL=https://www.laihealthcaresolutions.com

# Contact form email delivery through Microsoft Graph (the client's Microsoft 365 account).
# Used when MS_TENANT_ID, MS_CLIENT_ID and MS_CLIENT_SECRET are all set. These come from the Microsoft Entra app
# registration with the Mail.Send application permission (admin consent granted), the same one the Elevate site uses.
# Never commit real values.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Shared mailbox the form sends FROM (display name "LAI Healthcare Solutions"). It sends both the inquiry to MAIL_TO
# and the confirmation to the visitor. Outlook shows its display name and address as the sender.
# Never use the recipient's own mailbox: Outlook files self-sent mail under "Note to self" instead of the Inbox.
# Requires laihealthcaresolutions.com in the Microsoft 365 tenant (see docs/email-setup.md).
MAIL_SENDER_UPN=noreply@laihealthcaresolutions.com
# Inbox that receives contact form messages. Falls back to CONTACT_TO_EMAIL, then hello@laihealthcaresolutions.com.
MAIL_TO=stephanie@elevatelogisticsolutions.com

# Optional fallback: Resend (https://resend.com), used only when the Microsoft Graph variables above are not set.
RESEND_API_KEY=
# Inbox that receives contact form messages when MAIL_TO is not set.
CONTACT_TO_EMAIL=hello@laihealthcaresolutions.com
# Resend sender address. Must be on a domain verified in Resend (add the DNS records Resend provides).
# Until the domain is verified you can use: LAI Healthcare Solutions <onboarding@resend.dev>
CONTACT_FROM_EMAIL=LAI Healthcare Solutions <website@laihealthcaresolutions.com>
