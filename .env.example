# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.

# Public URL of the site (used for canonical URLs, sitemap and Open Graph tags).
NEXT_PUBLIC_SITE_URL=https://www.laihealthcaresolutions.com

# Contact form email delivery (https://resend.com).
RESEND_API_KEY=
# Inbox that receives contact form messages.
CONTACT_TO_EMAIL=hello@laihealthcaresolutions.com
# Sender address. Must be on a domain verified in Resend (add the DNS records Resend provides).
# Until the domain is verified you can use: LAI Healthcare Solutions <onboarding@resend.dev>
CONTACT_FROM_EMAIL=LAI Healthcare Solutions <website@laihealthcaresolutions.com>
